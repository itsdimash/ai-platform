# --- API-ключи провайдеров ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- База данных сервиса (логи, история чатов) ---
DATABASE_URL=postgresql+asyncpg://ai_platform:password@localhost:5432/ai_platform

# --- Read-only подключение к БД ERP (для db_query) ---
ERP_READONLY_DATABASE_URL=postgresql+asyncpg://ai_readonly:password@localhost:5432/erp_db

# --- JWT (общий секрет с ERP-бэкендом, чтобы не логиниться дважды) ---
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Cloudflare R2 (хранилище файлов) ---
# Дефолтов в коде нет. Bucket и ключи общие с ERP (R2_BUCKET_NAME=erp).
# Файлы ai-platform лежат под префиксом ai/ и отдаются ТОЛЬКО presigned-ссылками;
# существующие объекты вне ai/ сервис не читает и не меняет.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
# Необязательно: для ai/ публичный домен не используется.
R2_PUBLIC_DOMAIN=
# Срок жизни presigned-ссылки, секунд (60..604800).
R2_PRESIGN_EXPIRES=3600

# --- Прочее ---
ENVIRONMENT=development
LOG_LEVEL=INFO
