# --- API-ключи провайдеров ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- База данных сервиса (логи, история чатов) ---
DATABASE_URL=postgresql+asyncpg://ai_platform:password@localhost:5432/ai_platform

# --- Read-only подключение к БД ERP (для db_query) ---
ERP_READONLY_DATABASE_URL=postgresql+asyncpg://ai_readonly:password@localhost:5432/erp_db

# --- JWT (общий секрет с ERP-бэкендом, чтобы не логиниться дважды) ---
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Cloudflare R2 (хранилище файлов) ---
# Дефолтов в коде больше нет: без этих значений создание файлов вернёт ошибку.
# Bucket/аккаунт могут быть общими с ERP — тогда значения те же, что в ERP .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
# Публичный домен bucket. Нужен, пока файлы отдаются публичными ссылками
# (до перехода на приватные presigned-ссылки).
R2_PUBLIC_DOMAIN=

# --- Прочее ---
ENVIRONMENT=development
LOG_LEVEL=INFO
